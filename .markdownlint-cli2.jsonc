{
  // Markdown lint for a small docs + composite-action repo. Correctness rules
  // (code-fence language, hard tabs, heading spacing, final newline, link
  // hygiene) stay ON; cosmetic rules that fight normal prose READMEs are OFF.
  "config": {
    "default": true,

    "MD013": false, // line length
    "MD012": false, // multiple consecutive blank lines (release-please CHANGELOG format)
    "MD033": false, // inline HTML (<!-- comments -->, marker snippets)
    "MD036": false, // bold line as pseudo-heading (issue-template field labels)
    "MD041": false, // first line need not be a top-level heading

    // release-please regenerates CHANGELOG.md with repeated section headings
    // (### Features, etc.) under different version parents. siblings_only scopes
    // no-duplicate-heading to same-parent only.
    "MD024": { "siblings_only": true },
    "MD007": { "indent": 2 }
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules", "**/node_modules", ".git"]
}
