{
  "name": "openspec-pr-action",
  "version": "1.0.0",
  "description": "GitHub Action that validates OpenAPI specification files in pull requests",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "package": "npm run build && ncc build dist/index.js --license licenses.txt -o dist",
    "test": "jest",
    "lint": "tsc --noEmit",
    "all": "npm run build && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acatl/openspec-pr-action.git"
  },
  "keywords": [
    "github-actions",
    "openapi",
    "spectral",
    "validation",
    "pull-request"
  ],
  "author": "acatl",
  "license": "MIT",
  "overrides": {
    "undici": "^7.28.0"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^8.0.1",
    "@actions/glob": "^0.4.0",
    "@stoplight/spectral-core": "^1.18.3",
    "@stoplight/spectral-formats": "^1.7.0",
    "@stoplight/spectral-rulesets": "^1.19.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@vercel/ncc": "^0.38.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  }
}
